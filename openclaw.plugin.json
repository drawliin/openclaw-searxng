{
  "id": "searxng-search",
  "name": "SearXNG Web Search",
  "description": "Self-hosted SearXNG-powered web_search tool for agents, with optional Tavily backend",
  "version": "0.2.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "provider": {
        "type": "string",
        "enum": ["searxng", "tavily"],
        "description": "Search provider to use",
        "default": "searxng"
      },
      "searxngUrl": {
        "type": "string",
        "description": "Base URL of the SearXNG instance",
        "default": "http://localhost:8080"
      },
      "engines": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Search engines to use (SearXNG only)",
        "default": ["duckduckgo", "brave", "grokipedia", "wikipedia", "github"]
      },
      "timeout": {
        "type": "number",
        "description": "Request timeout in milliseconds (SearXNG only)",
        "default": 10000
      },
      "tavilyApiKey": {
        "type": "string",
        "description": "Tavily API key (falls back to TAVILY_API_KEY env var)"
      }
    }
  },
  "uiHints": {
    "provider": {
      "label": "Search Provider",
      "placeholder": "searxng"
    },
    "searxngUrl": {
      "label": "SearXNG URL",
      "placeholder": "http://localhost:8080"
    },
    "engines": {
      "label": "Search Engines"
    },
    "timeout": {
      "label": "Timeout (ms)",
      "placeholder": "10000"
    },
    "tavilyApiKey": {
      "label": "Tavily API Key",
      "placeholder": "tvly-...",
      "secret": true
    }
  }
}
